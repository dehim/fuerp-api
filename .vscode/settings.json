{
  /* ========= 基础编辑体验 ========= */
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.renderWhitespace": "boundary",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,

  /* ========= 默认格式化器 ========= */
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  /* ========= 前端语言 ========= */
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  /* ========= PHP / Yii2 ========= */
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },

  "php.validate.enable": true,
  "php.validate.executablePath": "D:\\phpstudy_pro\\Extensions\\php\\php8.4.15nts\\php.exe",

  /* php-cs-fixer（CLI + PHP 版本对齐） */
  "php-cs-fixer.executablePath": "C:\\Users\\dehim\\AppData\\Roaming\\Composer\\vendor\\bin\\php-cs-fixer.bat",
  "php-cs-fixer.phpExecutablePath": "D:\\phpstudy_pro\\Extensions\\php\\php8.4.15nts\\php.exe",

  /* ========= Intelephense ========= */
  "intelephense.environment.phpVersion": "8.4",
  "intelephense.files.maxSize": 5000000,
  "intelephense.completion.insertUseDeclaration": true,

  /* ========= Vue / TS ========= */
  "vue.volar.takeOverMode.enabled": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",

  /* ========= Tailwind ========= */
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.experimental.classRegex": [
    ["class\\s*=\\s*\"([^\"]*)\"", "\"([^\"]*)\""]
  ],

  /* ========= 文件细节 ========= */
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
